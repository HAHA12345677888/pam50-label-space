.vscode/
.idea/
*.swp
*.swo

# Data (too large for GitHub)
*.npz
*.csv
*.json
data/

# Checkpoints (too large for GitHub)
checkpoints/
checkpoints_*/

# Results
# results/ is tracked: it holds the JSON outputs behind the manuscript's
# reported numbers, which the Code Availability statement points to.
results_*/

# LaTeX intermediate files
*.aux
*.log
*.out
*.xdv
*.fdb_latexmk
*.fls

# LaTeX outputs are ignored, but the manuscript figure PDFs are part of the
# reproducibility package (the paper embeds them directly), so they are kept.
!paper/figures/*.pdf
!figures/*.pdf

# OS
.DS_Store
Thumbs.db

# Notebooks
.ipynb_checkpoints/
*.ipynb

# Scripts are tracked: they are the analysis code the manuscript cites.

# Install scripts
install_latex.sh

# Workspace
*.code-workspace

# Tracked exception: the JSON outputs behind the manuscript's reported
# numbers are part of the reproducibility package (see Code Availability),
# as is the raw detector simulation dump, which lets the metrics be
# re-scored without re-running the 720-cohort job.
!results/route_a/*.json
!results/route_a/*.npz

# CatBoost training logs
catboost_info/

# Figure verification renders (regenerable from the figure scripts)
figJ_check.png
